    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "El Humedal El Limonar, ubicado frente a Gratamira, es un ecosistema urbano
    en recuperaci\xF3n que alberga diversas especies de aves, flora del bosque seco
    tropical e incluso iguanas y guatines. Se han sembrado unos 690 \xE1rboles y
    se han creado senderos y zonas verdes para la comunidad."
